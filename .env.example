TERRAOPS_API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000
PROMETHEUS_URL=http://localhost:9090

# Which adapter the agent uses: anthropic | lmstudio
LLM_PROVIDER=anthropic

# Anthropic (reference provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# LM Studio (free, local): start the server in LM Studio (Developer tab), load a model.
OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
OPENAI_COMPAT_API_KEY=lm-studio
# leave empty to use whatever model is loaded in LM Studio
OPENAI_COMPAT_MODEL=

# RAG (Sprint 2)
RAG_STORE_PATH=.rag_store
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Drift tool: runs TerraOps' drift_report.py CLI against the published Postgres port
TERRAOPS_REPO=D:\TerraOps
TERRAOPS_DB_URI=postgresql://mlflow:mlflow@localhost:55433/mlflow

# Evaluation (Sprint 3): judge defaults to the agent's provider; set a DIFFERENT model to
# limit self-preference bias, e.g. JUDGE_PROVIDER=anthropic JUDGE_MODEL=claude-sonnet-5
JUDGE_PROVIDER=
JUDGE_MODEL=
